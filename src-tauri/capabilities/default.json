{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability: allow opening OAuth URLs in the system browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/login/device" },
        { "url": "https://auth.openai.com/*" }
      ]
    }
  ]
}
